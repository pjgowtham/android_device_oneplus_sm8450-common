soong_namespace {
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6490/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6490/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6490/WCNSS_qcom_cfg.ini",
    symlink_target: "/odm/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

cc_library_shared {
    name: "libqti_c2_store_abi_check",
    vendor: true,
    defaults: ["libcodec2-hidl-defaults@1.0"],
    shared_libs: ["libcodec2_hidl@1.2"],
    srcs: [
        "c2_store_abi_check/abi_check_1_0.cpp",
        "c2_store_abi_check/abi_check_1_2.cpp",
    ],
}
